# Переменные для корневого docker-compose.yml (полная интеграция всех 4 сервисов).
# Все значения ниже уже имеют рабочие дефолты прямо в docker-compose.yml (${VAR:-default}) —
# `docker compose up --build` из этой директории запустится и без .env. Создавайте .env
# только если хотите переопределить дефолты (например, свой SESSION_ENCRYPTION_KEY для не-dev окружения).

POSTGRES_USER=data_service
POSTGRES_PASSWORD=data_service
POSTGRES_DB=data_service

# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Дефолт в docker-compose.yml — dev-ключ, годится только для локальной проверки.
SESSION_ENCRYPTION_KEY=
DEFAULT_LOCK_TTL_SECONDS=900

# fake — детерминированные лиды/DryRunAdapter без браузера (по умолчанию для e2e smoke);
# playwright — реальный VK через Playwright (нужен залогиненный аккаунт).
VK_ADAPTER_MODE=fake
VK_HEADLESS=true
MIN_DELAY_SEC=1.0
MAX_DELAY_SEC=3.0

POLL_INTERVAL_SEC=5
POLL_TIMEOUT_SEC=1800

LOG_LEVEL=INFO
