# Full DSN used by the data-service app (Alembic + SQLAlchemy).
DATABASE_URL=postgresql+psycopg://data_service:data_service@localhost:5433/data_service

# Used by the `db` container in docker-compose.yml to init Postgres.
POSTGRES_USER=data_service
POSTGRES_PASSWORD=data_service
POSTGRES_DB=data_service

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

DEFAULT_LOCK_TTL_SECONDS=900
LOG_LEVEL=INFO
