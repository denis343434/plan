DATA_SERVICE_URL=http://localhost:8001

# fake — DryRunAdapter, без браузера, логирует "would send" (по умолчанию, для CI/dev);
# playwright — реальный VK через Playwright (нужен залогиненный аккаунт, см. scripts/vk_manual_login.py).
VK_ADAPTER_MODE=fake
VK_HEADLESS=true
MIN_DELAY_SEC=1.0
MAX_DELAY_SEC=3.0
# Короткая пауза "дать странице устояться" внутри отправки (пауза между лидами — MIN/MAX_DELAY_SEC выше).
SEND_SETTLE_MIN_SEC=0.3
SEND_SETTLE_MAX_SEC=0.8
# Задержка между нажатиями при наборе текста, мс (0/0 — без задержек).
TYPING_DELAY_MIN_MS=10
TYPING_DELAY_MAX_MS=40
# Сколько браузеров (по одному на аккаунт) держать открытыми во время рассылки.
SEND_MAX_OPEN_BROWSERS=3
# Прокси для VK-браузеров (рассылка, follow-up, ответы, проверка входящих): http://login:pass@host:port.
# Пусто — без прокси.
VK_PROXY=

# Telegram Web / WhatsApp Web (лиды из Яндекс Карт): fake — dry-run, playwright — реальная отправка
# (нужен аккаунт со входом через кнопку «Войти в Telegram»/«Войти в WhatsApp» в панели).
TG_ADAPTER_MODE=fake
TG_MIN_DELAY_SEC=5
TG_MAX_DELAY_SEC=12
# Прокси для Telegram (рассылка и окно входа): http://login:pass@host:port. Пусто — без прокси.
TG_PROXY=
WA_ADAPTER_MODE=fake
WA_MIN_DELAY_SEC=10
WA_MAX_DELAY_SEC=25
# Facebook Messenger (лиды из Google Карт): нужен аккаунт со входом через «Войти в Facebook».
FB_ADAPTER_MODE=fake
FB_MIN_DELAY_SEC=10
FB_MAX_DELAY_SEC=25
# Прокси для Facebook (в РФ заблокирован). Пусто — используется TG_PROXY.
FB_PROXY=

LOG_LEVEL=INFO
