DATA_SERVICE_URL=http://localhost:8001

# fake — детерминированные лиды без браузера (по умолчанию, для CI/dev);
# playwright — реальный VK через Playwright (нужен залогиненный аккаунт, см. scripts/vk_manual_login.py).
VK_ADAPTER_MODE=fake
VK_HEADLESS=true
MIN_DELAY_SEC=1.0
MAX_DELAY_SEC=3.0
# Таймаут ожидания поля "сайт" на странице группы (мс) — см. комментарий у настройки в config.py.
VK_SITE_CHECK_TIMEOUT_MS=4000
# Пауза (мин) перед тем, как парсинг-аккаунт снова станет доступен для нового цикла — см.
# комментарий у настройки в config.py.
VK_PARSE_COOLDOWN_MIN=2

LOG_LEVEL=INFO
