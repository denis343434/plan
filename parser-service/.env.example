DATA_SERVICE_URL=http://localhost:8001

# fake — детерминированные лиды без браузера (по умолчанию, для CI/dev);
# playwright — реальный VK через Playwright (нужен залогиненный аккаунт, см. scripts/vk_manual_login.py).
VK_ADAPTER_MODE=fake
VK_HEADLESS=true
MIN_DELAY_SEC=1.0
MAX_DELAY_SEC=3.0
# Таймаут ожидания поля "сайт" на странице группы (мс) — см. комментарий у настройки в config.py.
VK_SITE_CHECK_TIMEOUT_MS=4000
# Фразы в названии группы, при которых группа пропускается (JSON-список, без учёта регистра).
VK_EXCLUDED_TITLE_PHRASES=["ищу модель"]

# Яндекс Карты (аккаунт не нужен): fake — детерминированные лиды, playwright — реальный парсинг.
YANDEX_ADAPTER_MODE=fake
YANDEX_MIN_DELAY_SEC=1.5
YANDEX_MAX_DELAY_SEC=3.5

# Google Карты — то же самое.
GOOGLE_ADAPTER_MODE=fake
GOOGLE_MIN_DELAY_SEC=1.5
GOOGLE_MAX_DELAY_SEC=3.5

LOG_LEVEL=INFO
